# DriveShieldX — .env.example
# Copy this to `.env` and adjust the values before running the dashboard.

# --- UPI payment (real challan collections go to this VPA) ---
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=DriveShieldX Traffic Authority
CONTACT_PHONE=+91XXXXXXXXXX

# --- Optional overrides ---
# DRIVESHIELDX_DB_PATH=/absolute/path/to/overspeed.db
# DRIVESHIELDX_SPEED_LIMIT=60

# --- Road-safety layer (all optional) ---
# DSX_DISPATCH_MODE=control_room          # or "direct" to also message hospitals/police
# DSX_CONTROL_ROOM_PHONE=+91XXXXXXXXXX
# DSX_CONTROL_ROOM_EMAIL=control-room@example.org
# DSX_ENABLE_FOG=1
# DSX_ENABLE_ACCIDENT=1
# DSX_MAX_PLAUSIBLE_KMH=200
# DSX_DEFAULT_FPS=25                       # used only when the source does not report FPS

# --- SMS gateway (optional; outbox files are always written) ---
# DSX_SMS_PROVIDER=smsgate                 # smsgate | textbee | twilio | fast2sms | webhook
# SMSGATE_USER= / SMSGATE_PASSWORD=        # from the SMSGate Android app (Cloud server section)
# SMSGATE_URL=http://<phone-ip>:8080/message   # only for the app's Local server mode
# TEXTBEE_API_KEY= / TEXTBEE_DEVICE_ID=    # textbee.dev: an Android phone sends from its own SIM
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=+1XXXXXXXXXX
# FAST2SMS_API_KEY=
# DSX_SMS_WEBHOOK_URL= / DSX_SMS_WEBHOOK_TOKEN=
# DSX_SMS_ALLOWLIST=+91XXXXXXXXXX,+91YYYYYYYYYY   # ONLY these numbers get real SMS (team phones)
# DSX_SMS_ALLOW_ALL=0                      # 1 = text any number (never for a student demo)

# --- Vehicle registry (RC verification API; VAHAN has no free public API) ---
# DSX_RC_API_URL=                         # may contain {plate} for GET APIs
# DSX_RC_API_KEY=
# DSX_RC_API_METHOD=POST                   # or GET
# DSX_RC_API_AUTH=bearer                   # or header:<HeaderName>
# DSX_RC_API_HEADERS={"account-id":"..."}  # extra headers, if the provider needs two keys
# DSX_RC_API_BODY_TEMPLATE={"data":{"rc_number":"{plate}"}}   # nested bodies; {plate} {uuid}
# DSX_RC_API_BODY_KEY=id_number
# DSX_RC_API_ROOT=data
# DSX_RC_API_MAP={"fitness_upto":"fit_up_to"}
# DSX_RC_CACHE_HOURS=24

# --- Online payments: Razorpay (optional; without keys the built-in demo checkout is used) ---
# Keys: Razorpay Dashboard -> Account & Settings -> API Keys. NEVER commit real values.
# DSX_PAYMENT_MODE=test                    # test | live
# RAZORPAY_KEY_ID_TEST=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET_TEST=
# RAZORPAY_KEY_ID_LIVE=rzp_live_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET_LIVE=
# RAZORPAY_WEBHOOK_SECRET=                 # the secret you type when creating the webhook
# DSX_PUBLIC_BASE_URL=http://localhost:8501   # Razorpay sends the payer's browser back here
# DSX_LIVE_MAX_AMOUNT=10                   # live-mode cap per challan in rupees (demo safety)
# DSX_PAYMENT_POLL_SECONDS=30              # auto-record paid challans every N s (0 = off)

# --- Repeat offenders and unpaid challans (docs/ENFORCEMENT.md, docs/ESCALATION.md) ---
# DSX_STRIKE_WINDOW_DAYS=365
# DSX_ANNUAL_SUSPENSION_COUNT=5            # challans per year that suspend the licence
# DSX_ANNUAL_SUSPENSION_MONTHS=3
# DSX_CONTEST_DAYS=45
# DSX_PAY_AFTER_CONTEST_DAYS=30
# DSX_GRACE_AFTER_REJECTION_DAYS=15
# DSX_COURT_AFTER_DAYS=90
# DSX_REMINDER_DAYS=7,13
# DSX_ESCALATION_DAY_SECONDS=86400         # demo only: 60 = one "day" per minute

# --- Plate reading ---
# fastplate (default; EasyOCR if it is not installed) | auto (fastplate + EasyOCR on unsure plates) | easyocr
# DSX_OCR_ENGINE=fastplate
# DSX_FASTPLATE_MODEL=cct-s-v2-global-model

# --- Automatic helmet / triple-riding / seat-belt challans ---
# Detection -> plate -> registry check -> e-challan; unverified plates go to officer review.
# DSX_AUTO_ISSUE_RULES=1
# DSX_AUTO_ISSUER_ID=2        # officer user_id recorded as issuer (default: first traffic authority)
